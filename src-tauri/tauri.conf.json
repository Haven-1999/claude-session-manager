{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Session Manager",
  "version": "0.1.0",
  "identifier": "com.claude-session-manager.app",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src-tauri/setup",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Claude Session Manager",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "transparent": false,
        "decorations": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' 'unsafe-inline' http://127.0.0.1:18080 https://esm.sh",
        "connect-src": "'self' http://127.0.0.1:18080 ws://127.0.0.1:18080 https://esm.sh",
        "script-src": "'self' 'unsafe-inline' https://esm.sh",
        "style-src": "'self' 'unsafe-inline'"
      },
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.13",
      "signingIdentity": "-"
    }
  }
}
